{
  "name": "Gramophone",
  "short_name": "Gramophone",
  "description": "A vinyl music player that reads the melody, hooks and beat of your songs.",
  "start_url": "./",
  "scope": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0a0b",
  "theme_color": "#0c0a0b",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".m4b",
            ".aac",
            ".flac",
            ".wav",
            ".ogg",
            ".oga",
            ".opus",
            ".webm",
            ".aif",
            ".aiff",
            ".caf"
          ]
        }
      ]
    }
  }
}
